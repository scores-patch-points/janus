     "at": "06-government-legal/un-udhr/udhr-vmw.txt#4592-4682",
     "ref": "06-government-legal/un-udhr/udhr-vmw.txt",
     "text": "Wakunla mutthu onoomoliwa n’autoridade ohaana edireito yoveka ni okhala ilapo sa okhopela."
    }
