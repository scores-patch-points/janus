  {
   "id": "cha united|nations|chajitichisye mitwe ja ufulu wa chipago wa mundu jwalijose",
   "subject": "cha United",
   "verb": "nations",
   "object": "chajitichisye mitwe ja ufulu wa chipago wa mundu jwalijose",
