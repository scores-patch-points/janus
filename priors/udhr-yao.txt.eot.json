   "spans": [
    {
     "at": "06-government-legal/un-udhr/udhr-yao.txt#470-579",
     "ref": "06-government-legal/un-udhr/udhr-yao.txt",
     "text": "Pa 10 December, 1948, chiwanja cha United Nations chajitichisye mitwe ja ufulu wa chipago wa mundu jwalijose."
    },
    {
     "at": "06-government-legal/un-udhr/udhr-yao.txt#935-1122",
     "ref": "06-government-legal/un-udhr/udhr-yao.txt",
     "text": "Chiwanja cha United Nations chilichitamilisye jele mitweji, chayiwendile yilambo yayili mamembala gakwe kuti ijenesye posepose jele mitweji kuti wandu ajimanyilie nikujikamulisya masengo."
    },
    {
     "at": "06-government-legal/un-udhr/udhr-yao.txt#1445-1537",
     "ref": "06-government-legal/un-udhr/udhr-yao.txt",
     "text": "Paligongo ali, chiwanja cha United nations chilipeleche kugagosa maufulu ga mundu jwalijose."
    }
   ]
  },
  {
   "id": "cha united|nations|mumkamulano wakolanjikwa universal declaration of human rights",
   "subject": "cha United",
   "verb": "nations",
   "object": "mumkamulano wakolanjikwa Universal Declaration of Human Rights",
   "witnesses": [
